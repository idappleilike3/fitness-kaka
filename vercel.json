{
  "functions": {
    "src/app/api/line/webhook/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/newebpay/notify/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/member-engagement?window=morning",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/member-engagement?window=noon",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/member-engagement?window=evening",
      "schedule": "0 13 * * *"
    }
  ]
}
